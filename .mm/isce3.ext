# -*- Makefile -*-


# the python bindings
isce3.ext.root := python/extensions/pybind_isce3/
isce3.ext.stem := isce3
isce3.ext.pkg := isce3.pkg
isce3.ext.wraps := isce3.lib
isce3.ext.capsule :=
isce3.ext.extern := gdal hdf5 eigen fftw pyre pybind11 python

# if there is cuda
ifdef cuda.dir
  # mark
  isce3.ext.lib.defines += ISCE3_CUDA
  # add the package to the external dependencies
  isce3.ext.extern += cuda
else
  # exclude the bindings for the CUDA code
  isce3.ext.lib.directories.exclude := cuda
endif

isce3.ext.lib.c++.flags += $($(compiler.c++).std.c++17) -fopenmp

# after https://github.com/NVIDIA/cccl/pull/443, thrust creates an architecture specific
# inline namespace for all its symbols. #1756 added these symbols to suppress this.
# see the comments in cxx/isce3/cuda/CMakeLists.txt
# IMO, this should be considered a temporary fix, as thrust is likely to evolve to lean on
# this namespace

isce3.ext.c++.defines += THRUST_DISABLE_ABI_NAMESPACE THRUST_IGNORE_ABI_NAMESPACE_ERROR
# end of file
